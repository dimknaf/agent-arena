# Copy to .env and fill in. NEVER commit .env — the repo is public.

# Daytona — https://app.daytona.io  (redeem coupon at /dashboard/billing)
DAYTONA_API_KEY=

# Parallel — https://platform.parallel.ai
PARALLEL_API_KEY=

# SEC EDGAR requires a descriptive User-Agent or it returns 403 + ~10 min IP block
SEC_USER_AGENT=AgentArena dimknaf@gmail.com

# Optional fallback if transplanted Codex ChatGPT auth does not work in-sandbox
OPENAI_API_KEY=

# Region: eu or us. Without this the API rejects creates unless the org has a default region.
DAYTONA_TARGET=eu

# auto|concise|detailed|none. "detailed" makes codex emit reasoning items
# which the UI renders as THOUGHT cards. Costs ~+30s and ~1.4% tokens.
ARENA_REASONING_SUMMARY=detailed
